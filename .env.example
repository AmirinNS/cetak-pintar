# Run mode: development | testing | production
#   development — native Flask server, debug on
#   testing     — native Flask server, debug on
#   production  — waitress WSGI server, debug off
APP_ENV=development

# Required in production. The placeholder below is rejected when APP_ENV=production.
SECRET_KEY=change-me-in-production
PORT=5000

# Site identity for SEO (meta tags, canonical URLs, robots/sitemap)
SITE_NAME=CetakKira
SITE_URL=http://localhost:5000

# Reverse-proxy hops to trust in X-Forwarded-For. 0 ignores the header.
TRUSTED_PROXY_HOPS=0
# Rate limiting on the PDF route (memory storage, single process).
RATELIMIT_ENABLED=true
